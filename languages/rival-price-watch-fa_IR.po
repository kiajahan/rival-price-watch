msgid "Malaysian ringgit"
msgstr "رینگیت مالزی"

msgid "Thai baht"
msgstr "بات تایلند"

msgid "Indonesian rupiah"
msgstr "روپیه اندونزی"

msgid "Philippine peso"
msgstr "پزو فیلیپین"

msgid "Brazilian real"
msgstr "رئال برزیل"

msgid "Mexican peso"
msgstr "پزو مکزیک"

msgid "South African rand"
