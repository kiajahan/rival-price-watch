msgid "Omani rial"
msgstr "ریال عمان"

msgid "Turkish lira"
msgstr "لیر ترکیه"

msgid "Azerbaijani manat"
msgstr "منات آذربایجان"

msgid "Armenian dram"
msgstr "درام ارمنستان"

msgid "Georgian lari"
msgstr "لاری گرجستان"

msgid "Russian ruble"
msgstr "روبل روسیه"

msgid "Ukrainian hryvnia"
msgstr "گریونا اوکراین"

msgid "Israeli shekel"
msgstr "شکل اسرائیل"

msgid "Egyptian pound"
msgstr "پوند مصر"

msgid "Swedish krona"
msgstr "کرون سوئد"

msgid "Norwegian krone"
msgstr "کرون نروژ"

msgid "Danish krone"
