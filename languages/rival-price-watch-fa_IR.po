msgid "Rival Price Watch"
msgstr "ردیاب قیمت رقبا"

msgid "Track competitor prices for your WooCommerce products. Add competitor product links, get daily price checks, price history and email alerts when a rival is cheaper."
msgstr "قیمت رقبا را برای محصولات ووکامرس خود دنبال کنید. لینک همین محصول در سایت رقبا را اضافه کنید تا قیمت‌ها هر روز بررسی شوند، تاریخچه قیمت ذخیره شود و هر وقت رقیبی ارزان‌تر شد ایمیل بگیرید."

msgid "Rival Prices"
msgstr "قیمت رقبا"

msgid "Open"
msgstr "باز کردن"

msgid "Remove"
msgstr "حذف"

msgid "Reading the page…"
msgstr "در حال خواندن صفحه…"

msgid "The test could not be run. Please try again."
msgstr "آزمایش انجام نشد. دوباره تلاش کنید."

msgid "Paste a link first."
msgstr "اول یک لینک وارد کنید."

msgid "You are not allowed to do this."
msgstr "شما اجازه انجام این کار را ندارید."

msgid "This is not a link that can be checked."
msgstr "این لینک قابل بررسی نیست."

#, php-format
msgid "Price: %s"
msgstr "قیمت: %s"

#, php-format
msgid "In your currency: %s"
msgstr "به واحد پول شما: %s"

msgid "not stated on the page"
msgstr "در صفحه نوشته نشده"

msgid "in stock"
msgstr "موجود"

msgid "out of stock"
msgstr "ناموجود"

#, php-format
msgid "Stock: %s"
msgstr "موجودی: %s"

#, php-format
msgid "Product on the page: %s"
msgstr "محصول در صفحه: %s"

#, php-format
msgid "Read from: %s"
msgstr "خوانده‌شده از: %s"

#, php-format
msgid "This page lists %d offers or versions. The cheapest one in stock of the first product was used. Fill in \"Variant\" to pick the right one."
msgstr "این صفحه %d پیشنهاد یا مدل دارد. ارزان‌ترین مدل موجودِ اولین محصول انتخاب شد. برای انتخاب مدل درست، خانه «مدل» را پر کنید."

msgid "This page does not describe its versions in a way that can be read, so the variant text could not be checked."
msgstr "این صفحه مدل‌هایش را به شکلی که قابل خواندن باشد معرفی نکرده، پس متن «مدل» بررسی نشد."

#, php-format
msgid "The last alert email could not be sent (%s). The alerts are kept and sending will be tried again."
msgstr "آخرین ایمیل هشدار فرستاده نشد (%s). هشدارها نگه داشته شده‌اند و دوباره برای ارسال تلاش می‌شود."

msgid "Could not download exchange rates."
msgstr "دریافت نرخ‌های تبدیل ممکن نشد."

msgid "Exchange rates updated."
msgstr "نرخ‌های تبدیل به‌روز شد."

msgid "Exchange rates saved."
msgstr "نرخ‌های تبدیل ذخیره شد."

msgid "Checking started. Large catalogues are checked in small batches in the background; refresh this page in a few minutes."
msgstr "بررسی شروع شد. فروشگاه‌های بزرگ در دسته‌های کوچک و در پس‌زمینه بررسی می‌شوند؛ چند دقیقه دیگر این صفحه را تازه کنید."

msgid "Overview"
msgstr "نمای کلی"

msgid "Settings"
msgstr "تنظیمات"

#, php-format
msgid "Checking in progress: %d links left."
msgstr "در حال بررسی: %d لینک مانده است."

#, php-format
msgid "Next automatic check: %s"
msgstr "بررسی خودکار بعدی: %s"

msgid "Automatic checks are off."
msgstr "بررسی خودکار خاموش است."

msgid "Check all now"
msgstr "بررسی همه، همین حالا"

msgid "Market"
msgstr "بازار"

msgid "All markets (converted to shop currency)"
msgstr "همه بازارها (تبدیل به واحد پول فروشگاه)"

msgid "Show all products"
msgstr "نمایش همه محصولات"

msgid "Only where a rival is cheaper"
msgstr "فقط جایی که رقیب ارزان‌تر است"

msgid "No competitor links yet"
msgstr "هنوز لینک رقیبی اضافه نشده"

msgid "Open any product, find the \"Rival prices\" box, and paste the links of the same product on competitor sites. Prices are then checked automatically."
msgstr "یک محصول را باز کنید، کادر «قیمت رقبا» را پیدا کنید و لینک همین محصول را در سایت رقبا در آن بگذارید. از آن به بعد قیمت‌ها خودکار بررسی می‌شوند."

msgid "Product"
msgstr "محصول"

msgid "Your price"
msgstr "قیمت شما"

msgid "Cheapest rival"
msgstr "ارزان‌ترین رقیب"

msgid "Difference"
msgstr "اختلاف"

msgid "All rivals"
msgstr "همه رقبا"

msgid "Last checked"
msgstr "آخرین بررسی"

msgid "Never"
msgstr "هرگز"

msgid "Check now"
msgstr "بررسی همین حالا"

#, php-format
msgid "Rival %s%% cheaper"
msgstr "رقیب %s٪ ارزان‌تر"

#, php-format
msgid "You are %s%% cheaper"
msgstr "شما %s٪ ارزان‌ترید"

msgid "Same price"
msgstr "قیمت برابر"

msgid "not checked yet"
msgstr "هنوز بررسی نشده"

msgid "needs an exchange rate"
msgstr "نرخ تبدیل لازم است"

msgid "no price found"
msgstr "قیمتی پیدا نشد"

msgid "variant not found"
msgstr "مدل پیدا نشد"

msgid "currency unknown"
msgstr "واحد پول نامشخص"

msgid "variant not confirmed"
msgstr "مدل تأیید نشد"

msgid "different currency"
msgstr "ارز متفاوت"

msgid "settings changed, waiting for a new check"
msgstr "تنظیمات تغییر کرد، در انتظار بررسی دوباره"

msgid "error"
msgstr "خطا"

#, php-format
msgid "%s ago"
msgstr "%s پیش"

msgid "Check prices"
msgstr "بررسی قیمت‌ها"

msgid "Uses WP-Cron, which runs when someone visits your site. On quiet sites, set up a real server cron job for exact timing."
msgstr "از WP-Cron استفاده می‌شود که با بازدید از سایت اجرا می‌شود. اگر سایت بازدید کمی دارد، برای زمان‌بندی دقیق یک کران‌جاب واقعی روی سرور تنظیم کنید."

msgid "Email alerts"
msgstr "هشدار ایمیلی"

msgid "Email me when a competitor becomes cheaper than me"
msgstr "وقتی رقیبی از من ارزان‌تر شد به من ایمیل بزن"

msgid "Alert email address"
msgstr "نشانی ایمیل هشدار"

msgid "One email per check run, listing every product that changed. You are not emailed again until the price changes."
msgstr "در هر نوبت بررسی فقط یک ایمیل با فهرست همه محصولات تغییرکرده فرستاده می‌شود. تا قیمت دوباره عوض نشود ایمیل تکراری نمی‌گیرید."

msgid "Only when the competitor is cheaper by at least"
msgstr "فقط وقتی رقیب دست‌کم این‌قدر ارزان‌تر است:"

msgid "Pause between requests"
msgstr "مکث بین درخواست‌ها"

msgid "seconds"
msgstr "ثانیه"

msgid "A pause between pages keeps checks gentle on competitor sites and lowers the chance of being blocked."
msgstr "مکث بین صفحه‌ها فشار کمتری به سایت رقبا می‌آورد و احتمال مسدود شدن را کم می‌کند."

msgid "Keep price history for"
msgstr "نگه‌داشتن تاریخچه قیمت به مدت"

msgid "days"
msgstr "روز"

msgid "Exchange rates"
msgstr "نرخ تبدیل ارز"

#, php-format
msgid "Rival prices in another currency are converted to your shop currency (%s) before comparing. Fill in only the currencies your competitors use; leave the rest empty."
msgstr "قیمت رقبایی که با ارز دیگری می‌فروشند، پیش از مقایسه به واحد پول فروشگاه شما (%s) تبدیل می‌شود. فقط ارزهایی را که رقبایتان استفاده می‌کنند پر کنید و بقیه را خالی بگذارید."

msgid "Rial and toman are converted automatically (1 toman = 10 rials)."
msgstr "ریال و تومان خودکار به هم تبدیل می‌شوند (هر تومان = ۱۰ ریال)."

#, php-format
msgid "Official rates downloaded on %s."
msgstr "نرخ‌های رسمی در %s دریافت شد."

#, php-format
msgid "Last saved on %s."
msgstr "آخرین ذخیره: %s"

msgid "Fill in today's official rates"
msgstr "پر کردن با نرخ رسمی امروز"

msgid "From the free open.er-api.com service. Only sent when you click."
msgstr "از سرویس رایگان open.er-api.com. فقط وقتی کلیک کنید درخواست فرستاده می‌شود."

msgid "Your shop uses the rial or toman. Official rates are far from the free-market rate, so enter the market rate for each currency yourself."
msgstr "فروشگاه شما با ریال یا تومان کار می‌کند. نرخ رسمی با نرخ بازار آزاد فاصله زیادی دارد، پس نرخ بازار هر ارز را خودتان وارد کنید."

msgid "Save exchange rates"
msgstr "ذخیره نرخ‌های تبدیل"

#, php-format
msgid "The page answered with HTTP %d."
msgstr "صفحه با کد HTTP %d پاسخ داد."

msgid "The site may be blocking automatic checks."
msgstr "ممکن است آن سایت بررسی خودکار را مسدود کرده باشد."

#, php-format
msgid "None of the %2$d offers on the page matches \"%1$s\". Check the variant text for this link."
msgstr "هیچ‌کدام از %2$d پیشنهاد این صفحه با «%1$s» جور نیست. متن «مدل» این لینک را بررسی کنید."

msgid "No price found on the page. The site does not publish price data that can be read automatically."
msgstr "قیمتی در صفحه پیدا نشد. این سایت داده قیمتی که به‌صورت خودکار خوانده شود منتشر نمی‌کند."

#, php-format
msgid "The page sells in %1$s, but this link is set to %2$s, so the price is not compared. Choose %1$s (or Auto-detect) for this link, or use a page that sells in %2$s."
msgstr "این صفحه به %1$s می‌فروشد، اما ارز این لینک %2$s انتخاب شده است؛ برای همین قیمت مقایسه نمی‌شود. برای این لینک %1$s (یا تشخیص خودکار) را انتخاب کنید، یا صفحه‌ای را بگذارید که به %2$s می‌فروشد."

msgid "The page shows a price that cannot be real, so it was not used."
msgstr "صفحه قیمتی نشان می‌دهد که نمی‌تواند واقعی باشد، پس استفاده نشد."

#, php-format
msgid "A price was found, but the page does not show that it belongs to \"%s\", so it is not compared. Clear the variant text if this page only sells one version."
msgstr "قیمتی پیدا شد، اما صفحه نشان نمی‌دهد که مربوط به «%s» است، پس مقایسه نمی‌شود. اگر این صفحه فقط یک مدل می‌فروشد، خانه «مدل» را خالی کنید."

#, php-format
msgid "The page shows the price %s but does not say which currency it is in. Choose the currency for this link to compare it."
msgstr "صفحه قیمت %s را نشان می‌دهد اما نمی‌گوید به چه واحد پولی است. برای مقایسه، واحد پول این لینک را انتخاب کنید."

#, php-format
msgid "This site sells in %1$s. Add a %1$s to %2$s exchange rate in Settings to compare it."
msgstr "این سایت با %1$s می‌فروشد. برای مقایسه، نرخ تبدیل %1$s به %2$s را در تنظیمات وارد کنید."

#, php-format
msgid "- %1$s: your price %2$s, %3$s sells it for %4$s (%5$s)"
msgstr "- %1$s: قیمت شما %2$s، %3$s آن را %4$s می‌فروشد (%5$s)"

msgid "The alert email address in Settings is not valid."
msgstr "نشانی ایمیل هشدار در تنظیمات معتبر نیست."

msgid "These products are now cheaper at a competitor:"
msgstr "این محصولات اکنون نزد یک رقیب ارزان‌ترند:"

msgid "WordPress could not send the email."
msgstr "وردپرس نتوانست ایمیل را بفرستد."

