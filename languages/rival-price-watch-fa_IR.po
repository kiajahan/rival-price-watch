msgid "Malaysian ringgit"
msgstr "رینگیت مالزی"

msgid "Thai baht"
msgstr "بات تایلند"

msgid "Indonesian rupiah"
msgstr "روپیه اندونزی"

msgid "Philippine peso"
msgstr "پزو فیلیپین"

msgid "Brazilian real"
